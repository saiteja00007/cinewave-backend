# ==============================================================
# CINEWAVE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or set these in your hosting environment
# NEVER commit your production .env with real secrets to GitHub
# ==============================================================

# Server Port (default: 8080)
PORT=8080

# Database Configuration (MySQL / Aiven / Railway / RDS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinewave
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_SSL_MODE=PREFERRED

# JWT Authentication (Minimum 256-bit secret key)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# Initial Admin Credentials (Created on first startup if not existing)
ADMIN_EMAIL=admin@cinewave.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Cinema Administrator

# TMDB (The Movie Database) API Configuration
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_v3_here

# CORS Allowed Origins (Comma separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Email SMTP Provider (Gmail, SendGrid, Mailgun, Amazon SES)
# If left blank, OTP service operates in secure dev/sandbox mode and logs OTP to server console
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_smtp_app_password_here

# SMS Provider (Twilio / Fast2SMS)
# If left blank, SMS OTP service operates in secure dev/sandbox mode
CINEWAVE_SMS_API_KEY=your_twilio_or_sms_api_key
CINEWAVE_SMS_FROM=+1234567890

# Razorpay Payment Gateway (Test or Live mode)
# If left blank, payment gateway operates in sandbox simulation mode
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
